<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInPrimaryRenderer>True</BuiltInPrimaryRenderer>
    <AvaloniaUseCompiledBindingsByDefault>True</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UpdateChannel)' == 'win-alpha'">
    <DefineConstants>$(DefineConstants);ALPHA_UPDATE_CHANNEL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <!--Condition below is important for diagnostic purposes-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.2.3" />
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="SharpHook" Version="8.0.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="icon.png" />
    <Content Include="Presets\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
