<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LizardCrossPlatform.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    <Application.Resources>
        <x:String x:Key="TraySettingsText">Einstellungen</x:String>
        <x:String x:Key="TrayExitText">Beenden</x:String>
    </Application.Resources>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/icon.png" ToolTipText="Lizard Keyboard Sounds">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{DynamicResource TraySettingsText}" Click="OnSettingsClick"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="{DynamicResource TrayExitText}" Click="OnExitClick"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
